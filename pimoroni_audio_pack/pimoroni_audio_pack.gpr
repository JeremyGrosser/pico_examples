with "config/pimoroni_audio_pack_config.gpr";
with "runtime_build.gpr";

project pimoroni_audio_pack is

   for Target use Runtime_Build'Target;
   for Runtime ("Ada") use Runtime_Build'Runtime ("Ada");

   package Linker is
      for Switches ("Ada") use Runtime_Build.Linker_Switches;
   end Linker;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & pimoroni_audio_pack_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("pimoroni_audio_pack.adb");

   package Compiler is
      for Default_Switches ("Ada") use pimoroni_audio_pack_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end pimoroni_audio_pack;
